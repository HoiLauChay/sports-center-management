{
  "name": "@sports-center/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist .turbo node_modules/.tmp"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@hookform/resolvers": "^5.9.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "@sports-center/api": "workspace:*",
    "@sports-center/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "antd": "^6.6.4",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "lenis": "^1.3.26",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sports-center/eslint-config": "workspace:*",
    "@sports-center/typescript-config": "workspace:*",
    "@tanstack/router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.37",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
