{
  "name": "@sports-center/api",
  "version": "1.0.0",
  "private": true,
  "description": "Sports Center Management - REST API",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/server.ts",
    "build": "bun scripts/build.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "NODE_ENV=production prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "bun src/seeds/seed.ts",
    "clean": "rm -rf dist .turbo src/generated"
  },
  "lint-staged": {
    "**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sports-center/shared": "workspace:*",
    "@vercel/functions": "^3.9.9",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "resend": "^6.28.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sports-center/eslint-config": "workspace:*",
    "@sports-center/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "prisma": "7.10.0",
    "typescript": "~6.0.2"
  },
  "exports": {
    "./app": "./dist/app.js"
  }
}
