generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  COACH
  MEMBER
  RECEPTIONIST

  @@map("role")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BANNED

  @@map("account_status")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET

  @@map("otp_purpose")
}

model Account {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String        @unique @db.VarChar(255)
  phone             String?       @unique @db.VarChar(20)
  passwordHash      String        @map("password_hash") @db.VarChar(255)
  fullName          String        @map("full_name") @db.VarChar(255)
  avatarUrl         String?       @map("avatar_url")
  role              Role          @default(MEMBER)
  status            AccountStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz()
  passwordChangedAt DateTime      @default(now()) @map("password_changed_at") @db.Timestamptz()
  dateOfBirth       DateTime?     @map("date_of_birth") @db.Date
  gender            Gender?
  address           String?       @db.VarChar(500)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  memberProfile       MemberProfile?
  coachProfile        CoachProfile?
  receptionistProfile ReceptionistProfile?
  managerProfile      ManagerProfile?
  refreshTokens       RefreshToken[]

  createdMaintenances        FacilityMaintenance[]
  facilityPackages           FacilityPackage[]
  facilityBookings           FacilityBooking[]
  coachedClasses             Class[]                  @relation("ClassCoach")
  approvedClasses            Class[]                  @relation("ClassApprover")
  coachRegistrations         ClassCoachRegistration[] @relation("RegistrationCoach")
  reviewedCoachRegistrations ClassCoachRegistration[] @relation("RegistrationReviewer")
  classEnrollments           ClassEnrollment[]
  orders                     Order[]                  @relation("OrderBuyer")
  createdOrders              Order[]                  @relation("OrderCreator")
  memberships                MemberMembership[]
  createdWalletTransactions  WalletTransaction[]
  handledBankTransactions    BankTransaction[]
  notifications              Notification[]
  auditLogs                  AuditLog[]
  supportRequests            SupportRequest[]         @relation("SupportRequester")
  handledSupportRequests     SupportRequest[]         @relation("SupportHandler")
  updatedSettings            SystemSetting[]
  specializations            CoachSpecialization[]    @relation("SpecializationCoach")
  reviewedSpecializations    CoachSpecialization[]    @relation("SpecializationReviewer")

  @@index([role, status], map: "idx_accounts_role_status")
  @@map("accounts")
}

model MemberProfile {
  accountId        String   @id @map("account_id") @db.Uuid
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  emergencyContact String?  @map("emergency_contact") @db.VarChar(255)
  fitnessGoals     String?  @map("fitness_goals")
  healthNotes      String?  @map("health_notes")
  walletBalance    Decimal  @default(0) @map("wallet_balance") @db.Decimal(12, 0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  walletTransactions       WalletTransaction[]
  walletTopUps             WalletTopUp[]
  resolvedBankTransactions BankTransaction[]

  @@map("member_profile")
}

model CoachProfile {
  accountId      String   @id @map("account_id") @db.Uuid
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  bio            String?
  experience     String?
  certifications String?
  coverImageUrl  String?  @map("cover_image_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("coach_profile")
}

model ReceptionistProfile {
  accountId  String   @id @map("account_id") @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  staffNotes String?  @map("staff_notes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("receptionist_profile")
}

model ManagerProfile {
  accountId  String   @id @map("account_id") @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  staffNotes String?  @map("staff_notes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("manager_profile")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([accountId], map: "idx_refresh_tokens_account")
  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@map("refresh_tokens")
}

model OtpCode {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String     @db.VarChar(255)
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.VarChar(64)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz()
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz()
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  @@index([email, purpose], map: "idx_otp_email_purpose")
  @@map("otp_codes")
}

enum FacilityType {
  GYM
  COURT
  ROOM
  FIELD

  @@map("facility_type")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED

  @@map("booking_status")
}

enum BookingBenefit {
  NONE
  DISCOUNT
  GYM_ACCESS
  FREE_SLOT

  @@map("booking_benefit")
}

enum FacilityPackageStatus {
  ACTIVE
  CANCELLED

  @@map("facility_package_status")
}

enum ClassStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  CANCELLED

  @@map("class_status")
}

enum CoachRegistrationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("coach_registration_status")
}

enum CoachRegistrationSource {
  COACH_REGISTERED
  MANAGER_ASSIGNED

  @@map("coach_registration_source")
}

enum SessionStatus {
  SCHEDULED
  CANCELLED

  @@map("session_status")
}

enum EnrollmentStatus {
  ENROLLED
  CANCELLED

  @@map("enrollment_status")
}

enum OrderItemType {
  MEMBERSHIP
  FACILITY_BOOKING
  FACILITY_PACKAGE
  COURSE_ENROLLMENT

  @@map("order_item_type")
}

enum PaymentMethod {
  WALLET
  CASH
  CARD
  TRANSFER

  @@map("payment_method")
}

enum OrderStatus {
  PAID
  PARTIALLY_REFUNDED
  REFUNDED

  @@map("order_status")
}

enum DiscountType {
  PERCENT
  FIXED

  @@map("discount_type")
}

model Sport {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  description String?
  iconUrl     String?   @map("icon_url")
  isActive    Boolean   @default(true) @map("is_active")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  facilities           FacilitySport[]
  courses              Course[]
  coachSpecializations CoachSpecialization[]

  @@map("sports")
}

model Facility {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String       @db.VarChar(100)
  type            FacilityType
  capacityPerSlot Int          @map("capacity_per_slot")
  pricePerSlot    Decimal      @map("price_per_slot") @db.Decimal(12, 0)
  isActive        Boolean      @default(true) @map("is_active")
  description     String?
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz()
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  sports       FacilitySport[]
  maintenances FacilityMaintenance[]
  packages     FacilityPackage[]
  bookings     FacilityBooking[]
  classes      Class[]
  sessions     ClassSession[]

  @@map("facilities")
}

model FacilitySport {
  facilityId String   @map("facility_id") @db.Uuid
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  sportId    String   @map("sport_id") @db.Uuid
  sport      Sport    @relation(fields: [sportId], references: [id], onDelete: Restrict)

  @@id([facilityId, sportId])
  @@index([sportId], map: "idx_facility_sports_sport")
  @@map("facility_sports")
}

model FacilityMaintenance {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityId  String    @map("facility_id") @db.Uuid
  facility    Facility  @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  startAt     DateTime  @map("start_at") @db.Timestamptz()
  endAt       DateTime  @map("end_at") @db.Timestamptz()
  reason      String    @db.VarChar(500)
  createdById String    @map("created_by") @db.Uuid
  createdBy   Account   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([facilityId, startAt, endAt], map: "idx_fm_facility_range")
  @@map("facility_maintenances")
}

model FacilityPackage {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String                @map("account_id") @db.Uuid
  account     Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  facilityId  String                @map("facility_id") @db.Uuid
  facility    Facility              @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  orderItemId String                @unique @map("order_item_id") @db.Uuid
  orderItem   OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  daysOfWeek  Int[]                 @map("days_of_week")
  startTime   DateTime              @map("start_time") @db.Time()
  endTime     DateTime              @map("end_time") @db.Time()
  startDate   DateTime              @map("start_date") @db.Date
  endDate     DateTime              @map("end_date") @db.Date
  unitPrice   Decimal               @map("unit_price") @db.Decimal(12, 0)
  status      FacilityPackageStatus @default(ACTIVE)
  cancelledAt DateTime?             @map("cancelled_at") @db.Timestamptz()
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz()

  bookings FacilityBooking[]

  @@index([accountId, status], map: "idx_fp_account_status")
  @@map("facility_packages")
}

model FacilityBooking {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facilityId  String           @map("facility_id") @db.Uuid
  facility    Facility         @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  accountId   String?          @map("account_id") @db.Uuid
  account     Account?         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  orderItemId String           @map("order_item_id") @db.Uuid
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  packageId   String?          @map("package_id") @db.Uuid
  package     FacilityPackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  bookingDate DateTime         @map("booking_date") @db.Date
  startTime   DateTime         @map("start_time") @db.Time()
  endTime     DateTime         @map("end_time") @db.Time()
  unitPrice   Decimal          @map("unit_price") @db.Decimal(12, 0)
  benefit     BookingBenefit   @default(NONE)
  status      BookingStatus    @default(CONFIRMED)
  cancelledAt DateTime?        @map("cancelled_at") @db.Timestamptz()
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  @@index([facilityId, bookingDate, startTime], map: "idx_booking_facility_date_time")
  @@index([accountId, bookingDate], map: "idx_booking_account_date")
  @@index([packageId], map: "idx_booking_package")
  @@index([orderItemId], map: "idx_booking_order_item")
  @@map("facility_bookings")
}

model Course {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String    @db.VarChar(255)
  sportId       String    @map("sport_id") @db.Uuid
  sport         Sport     @relation(fields: [sportId], references: [id], onDelete: Restrict)
  description   String?
  totalSessions Int       @map("total_sessions")
  price         Decimal   @db.Decimal(12, 0)
  thumbnailUrl  String?   @map("thumbnail_url")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  classes Class[]

  @@map("courses")
}

model Class {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId            String      @map("course_id") @db.Uuid
  course              Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  coachId             String?     @map("coach_id") @db.Uuid
  coach               Account?    @relation("ClassCoach", fields: [coachId], references: [id], onDelete: Restrict)
  facilityId          String      @map("facility_id") @db.Uuid
  facility            Facility    @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  name                String      @db.VarChar(100)
  minStudents         Int         @default(1) @map("min_students")
  minStudentsOverride Boolean     @default(false) @map("min_students_override")
  maxStudents         Int         @map("max_students")
  startDate           DateTime?   @map("start_date") @db.Date
  endDate             DateTime?   @map("end_date") @db.Date
  weeklySchedule      Json        @map("weekly_schedule")
  status              ClassStatus @default(DRAFT)
  approvedById        String?     @map("approved_by") @db.Uuid
  approvedBy          Account?    @relation("ClassApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt          DateTime?   @map("approved_at") @db.Timestamptz()
  cancelReason        String?     @map("cancel_reason") @db.VarChar(500)
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz()
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  coachRegistrations ClassCoachRegistration[]
  sessions           ClassSession[]
  enrollments        ClassEnrollment[]

  @@index([courseId, status], map: "idx_classes_course_status")
  @@index([coachId], map: "idx_classes_coach")
  @@index([status, startDate, endDate], map: "idx_classes_status_dates")
  @@map("classes")
}

model ClassCoachRegistration {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId      String                  @map("class_id") @db.Uuid
  class        Class                   @relation(fields: [classId], references: [id], onDelete: Restrict)
  coachId      String                  @map("coach_id") @db.Uuid
  coach        Account                 @relation("RegistrationCoach", fields: [coachId], references: [id], onDelete: Restrict)
  source       CoachRegistrationSource
  status       CoachRegistrationStatus @default(PENDING)
  reviewedById String?                 @map("reviewed_by") @db.Uuid
  reviewedBy   Account?                @relation("RegistrationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?               @map("reviewed_at") @db.Timestamptz()
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz()

  @@index([classId, coachId], map: "idx_ccr_class_coach")
  @@map("class_coach_registrations")
}

model ClassSession {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId         String        @map("class_id") @db.Uuid
  class           Class         @relation(fields: [classId], references: [id], onDelete: Restrict)
  facilityId      String        @map("facility_id") @db.Uuid
  facility        Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  sessionNumber   Int           @map("session_number")
  sessionDate     DateTime      @map("session_date") @db.Date
  startTime       DateTime      @map("start_time") @db.Time()
  endTime         DateTime      @map("end_time") @db.Time()
  status          SessionStatus @default(SCHEDULED)
  cancelReason    String?       @map("cancel_reason") @db.VarChar(500)
  noteTitle       String?       @map("note_title") @db.VarChar(255)
  noteContent     String?       @map("note_content")
  noteAttachments Json?         @map("note_attachments")
  noteUpdatedAt   DateTime?     @map("note_updated_at") @db.Timestamptz()
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([classId, sessionNumber], map: "uq_cs_class_session_num")
  @@index([facilityId, sessionDate, startTime], map: "idx_cs_facility_date_time")
  @@index([sessionDate, startTime], map: "idx_cs_date_time")
  @@map("class_sessions")
}

model ClassEnrollment {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId     String           @map("class_id") @db.Uuid
  class       Class            @relation(fields: [classId], references: [id], onDelete: Restrict)
  accountId   String           @map("account_id") @db.Uuid
  account     Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  orderItemId String           @unique @map("order_item_id") @db.Uuid
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  status      EnrollmentStatus @default(ENROLLED)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz()
  cancelledAt DateTime?        @map("cancelled_at") @db.Timestamptz()

  @@index([classId, accountId], map: "idx_enrollment_class_account")
  @@index([accountId], map: "idx_enrollment_account")
  @@map("class_enrollments")
}

model Order {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber              String        @unique @map("order_number") @db.VarChar(50)
  idempotencyKey           String        @unique @map("idempotency_key") @db.VarChar(150)
  accountId                String?       @map("account_id") @db.Uuid
  account                  Account?      @relation("OrderBuyer", fields: [accountId], references: [id], onDelete: Restrict)
  createdById              String?       @map("created_by") @db.Uuid
  createdBy                Account?      @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  invoiceSnapshot          Json          @map("invoice_snapshot")
  subtotal                 Decimal       @db.Decimal(12, 0)
  membershipDiscountAmount Decimal       @default(0) @map("membership_discount_amount") @db.Decimal(12, 0)
  couponDiscountAmount     Decimal       @default(0) @map("coupon_discount_amount") @db.Decimal(12, 0)
  totalAmount              Decimal       @map("total_amount") @db.Decimal(12, 0)
  refundedAmount           Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 0)
  couponId                 String?       @map("coupon_id") @db.Uuid
  coupon                   Coupon?       @relation(fields: [couponId], references: [id], onDelete: Restrict)
  paymentMethod            PaymentMethod @map("payment_method")
  status                   OrderStatus   @default(PAID)
  guestName                String?       @map("guest_name") @db.VarChar(255)
  guestPhone               String?       @map("guest_phone") @db.VarChar(20)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  items              OrderItem[]
  walletTransactions WalletTransaction[]

  @@index([accountId], map: "idx_orders_account")
  @@index([createdAt, status], map: "idx_orders_date_status")
  @@index([couponId, accountId], map: "idx_orders_coupon_account")
  @@index([guestPhone], map: "idx_orders_guest_phone")
  @@map("orders")
}

model OrderItem {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                  String        @map("order_id") @db.Uuid
  order                    Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lineNumber               Int           @map("line_number")
  type                     OrderItemType
  itemSnapshot             Json          @map("item_snapshot")
  subtotal                 Decimal       @db.Decimal(12, 0)
  membershipDiscountAmount Decimal       @default(0) @map("membership_discount_amount") @db.Decimal(12, 0)
  couponDiscountAmount     Decimal       @default(0) @map("coupon_discount_amount") @db.Decimal(12, 0)
  totalAmount              Decimal       @map("total_amount") @db.Decimal(12, 0)
  refundedAmount           Decimal       @default(0) @map("refunded_amount") @db.Decimal(12, 0)
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  facilityPackage    FacilityPackage?
  bookings           FacilityBooking[]
  enrollment         ClassEnrollment?
  membershipOrder    MembershipOrder?
  walletTransactions WalletTransaction[]

  @@unique([orderId, lineNumber], map: "uq_order_item_line")
  @@index([type, createdAt], map: "idx_order_items_type_date")
  @@map("order_items")
}

model Coupon {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String          @db.VarChar(50)
  name            String          @db.VarChar(255)
  discountType    DiscountType    @map("discount_type")
  discountValue   Decimal         @map("discount_value") @db.Decimal(12, 0)
  maxDiscount     Decimal?        @map("max_discount") @db.Decimal(12, 0)
  minOrderAmount  Decimal?        @map("min_order_amount") @db.Decimal(12, 0)
  maxUses         Int?            @map("max_uses")
  maxUsesPerUser  Int             @default(1) @map("max_uses_per_user")
  applicableTypes OrderItemType[] @map("applicable_types")
  validFrom       DateTime        @map("valid_from") @db.Timestamptz()
  validTo         DateTime        @map("valid_to") @db.Timestamptz()
  isActive        Boolean         @default(true) @map("is_active")
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz()
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  orders Order[]

  @@map("coupons")
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED

  @@map("membership_status")
}

enum TransactionType {
  TOP_UP
  PAYMENT
  REFUND

  @@map("transaction_type")
}

enum TopUpStatus {
  PENDING
  SUCCESS
  EXPIRED

  @@map("top_up_status")
}

enum BankTransactionStatus {
  MATCHED
  UNMATCHED
  RESOLVED
  IGNORED

  @@map("bank_transaction_status")
}

model Membership {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String    @db.VarChar(255)
  description              String?
  price                    Decimal   @db.Decimal(12, 0)
  durationDays             Int       @map("duration_days")
  gymAccess                Boolean   @default(false) @map("gym_access")
  bookingDiscountPct       Int       @default(0) @map("booking_discount_pct")
  classDiscountPct         Int       @default(0) @map("class_discount_pct")
  freeBookingSlotsPerMonth Int       @default(0) @map("free_booking_slots_per_month")
  isActive                 Boolean   @default(true) @map("is_active")
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  memberMemberships MemberMembership[]

  @@map("memberships")
}

model MemberMembership {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId   String           @map("account_id") @db.Uuid
  account     Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  packageId   String           @map("package_id") @db.Uuid
  package     Membership       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  startDate   DateTime         @map("start_date") @db.Date
  endDate     DateTime         @map("end_date") @db.Date
  autoRenew   Boolean          @default(false) @map("auto_renew")
  status      MembershipStatus @default(ACTIVE)
  cancelledAt DateTime?        @map("cancelled_at") @db.Timestamptz()
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  periods MembershipOrder[]

  @@index([accountId, status], map: "idx_mm_account_status")
  @@index([status, endDate], map: "idx_mm_status_end")
  @@map("member_memberships")
}

model MembershipOrder {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId             String           @map("membership_id") @db.Uuid
  membership               MemberMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  orderItemId              String           @unique @map("order_item_id") @db.Uuid
  orderItem                OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  periodStart              DateTime         @map("period_start") @db.Date
  periodEnd                DateTime         @map("period_end") @db.Date
  gymAccess                Boolean          @map("gym_access")
  bookingDiscountPct       Int              @map("booking_discount_pct")
  classDiscountPct         Int              @map("class_discount_pct")
  freeBookingSlotsPerMonth Int              @map("free_booking_slots_per_month")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([membershipId, periodStart], map: "uq_membership_order_period")
  @@map("membership_orders")
}

model WalletTransaction {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String           @map("account_id") @db.Uuid
  account           MemberProfile    @relation(fields: [accountId], references: [accountId], onDelete: Restrict)
  transactionCode   String           @unique @map("transaction_code") @db.VarChar(50)
  idempotencyKey    String           @unique @map("idempotency_key") @db.VarChar(150)
  type              TransactionType
  topUpMethod       PaymentMethod?   @map("top_up_method")
  amount            Decimal          @db.Decimal(12, 0)
  balanceAfter      Decimal          @map("balance_after") @db.Decimal(12, 0)
  orderId           String?          @map("order_id") @db.Uuid
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId       String?          @map("order_item_id") @db.Uuid
  orderItem         OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  bankTransactionId String?          @unique @map("bank_transaction_id") @db.Uuid
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  createdById       String?          @map("created_by") @db.Uuid
  createdBy         Account?         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  description       String?          @db.VarChar(500)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  @@index([accountId, createdAt], map: "idx_wtx_account_date")
  @@index([type, createdAt], map: "idx_wtx_type_date")
  @@index([orderId], map: "idx_wtx_order")
  @@index([orderItemId], map: "idx_wtx_order_item")
  @@map("wallet_transactions")
}

model WalletTopUp {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId         String           @map("account_id") @db.Uuid
  account           MemberProfile    @relation(fields: [accountId], references: [accountId], onDelete: Restrict)
  paymentCode       String           @unique @map("payment_code") @db.VarChar(20)
  amount            Decimal          @db.Decimal(12, 0)
  status            TopUpStatus      @default(PENDING)
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz()
  bankTransactionId String?          @unique @map("bank_transaction_id") @db.Uuid
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz()
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([accountId, createdAt], map: "idx_top_ups_account_date")
  @@index([status, expiresAt], map: "idx_top_ups_status_expires")
  @@map("wallet_top_ups")
}

model BankTransaction {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sepayId           BigInt                @unique @map("sepay_id")
  bankName          String                @map("bank_name") @db.VarChar(100)
  accountNumber     String                @map("account_number") @db.VarChar(50)
  amount            Decimal               @db.Decimal(12, 0)
  content           String
  paymentCode       String?               @map("payment_code") @db.VarChar(50)
  referenceCode     String?               @map("reference_code") @db.VarChar(100)
  transactionDate   DateTime              @map("transaction_date") @db.Timestamptz()
  status            BankTransactionStatus
  resolvedAccountId String?               @map("resolved_account_id") @db.Uuid
  resolvedAccount   MemberProfile?        @relation(fields: [resolvedAccountId], references: [accountId], onDelete: Restrict)
  handledById       String?               @map("handled_by") @db.Uuid
  handledBy         Account?              @relation(fields: [handledById], references: [id], onDelete: Restrict)
  handledAt         DateTime?             @map("handled_at") @db.Timestamptz()
  note              String?               @db.VarChar(500)
  rawPayload        Json                  @map("raw_payload")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  topUp             WalletTopUp?
  walletTransaction WalletTransaction?

  @@index([status, transactionDate], map: "idx_bank_tx_status_date")
  @@index([paymentCode], map: "idx_bank_tx_payment_code")
  @@map("bank_transactions")
}

enum NotificationType {
  PAYMENT
  MEMBERSHIP
  BOOKING
  CLASS
  TRAINING
  SUPPORT
  SYSTEM

  @@map("notification_type")
}

enum SupportRequestCategory {
  ACCOUNT
  MEMBERSHIP
  BOOKING
  CLASS
  PAYMENT
  OTHER

  @@map("support_request_category")
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("support_request_status")
}

model Notification {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String           @map("account_id") @db.Uuid
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  type          NotificationType
  title         String           @db.VarChar(255)
  message       String
  referenceType String?          @map("reference_type") @db.VarChar(50)
  referenceId   String?          @map("reference_id") @db.Uuid
  dedupKey      String?          @unique @map("dedup_key") @db.VarChar(150)
  readAt        DateTime?        @map("read_at") @db.Timestamptz()
  sendEmail     Boolean          @default(false) @map("send_email")
  emailSentAt   DateTime?        @map("email_sent_at") @db.Timestamptz()
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  @@index([accountId, createdAt], map: "idx_noti_account_date")
  @@index([accountId, readAt], map: "idx_noti_account_read")
  @@index([createdAt], map: "idx_noti_date")
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId  String?  @map("account_id") @db.Uuid
  account    Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([entityType, createdAt], map: "idx_audit_entity_date")
  @@index([accountId, createdAt], map: "idx_audit_account_date")
  @@map("audit_logs")
}

model SupportRequest {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId      String                 @map("account_id") @db.Uuid
  account        Account                @relation("SupportRequester", fields: [accountId], references: [id], onDelete: Restrict)
  handledById    String?                @map("handled_by") @db.Uuid
  handledBy      Account?               @relation("SupportHandler", fields: [handledById], references: [id], onDelete: Restrict)
  category       SupportRequestCategory @default(OTHER)
  subject        String                 @db.VarChar(255)
  description    String
  resolutionNote String?                @map("resolution_note")
  status         SupportRequestStatus   @default(OPEN)
  resolvedAt     DateTime?              @map("resolved_at") @db.Timestamptz()
  deletedAt      DateTime?              @map("deleted_at") @db.Timestamptz()
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([accountId, status], map: "idx_sr_account_status")
  @@index([status, createdAt], map: "idx_sr_status_date")
  @@map("support_requests")
}

model SystemSetting {
  id                          Int      @id @default(1)
  openTime                    DateTime @default(dbgenerated("'06:00:00'::time without time zone")) @map("open_time") @db.Time()
  closeTime                   DateTime @default(dbgenerated("'22:00:00'::time without time zone")) @map("close_time") @db.Time()
  slotDurationMinutes         Int      @default(60) @map("slot_duration_minutes")
  maxAdvanceBookingDays       Int      @default(7) @map("max_advance_booking_days")
  bookingCancelDeadlineHours  Int      @default(24) @map("booking_cancel_deadline_hours")
  courseCancelDeadlineDays    Int      @default(3) @map("course_cancel_deadline_days")
  membershipExpiryWarningDays Int      @default(7) @map("membership_expiry_warning_days")
  topUpMinAmount              Decimal  @default(10000) @map("top_up_min_amount") @db.Decimal(12, 0)
  topUpExpiryMinutes          Int      @default(30) @map("top_up_expiry_minutes")
  updatedById                 String?  @map("updated_by") @db.Uuid
  updatedBy                   Account? @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt                   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("system_settings")
}

enum SpecializationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("specialization_status")
}

model CoachSpecialization {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coachId      String               @map("coach_id") @db.Uuid
  coach        Account              @relation("SpecializationCoach", fields: [coachId], references: [id], onDelete: Restrict)
  sportId      String               @map("sport_id") @db.Uuid
  sport        Sport                @relation(fields: [sportId], references: [id], onDelete: Restrict)
  status       SpecializationStatus @default(PENDING)
  reviewNote   String?              @map("review_note") @db.VarChar(500)
  reviewedById String?              @map("reviewed_by") @db.Uuid
  reviewedBy   Account?             @relation("SpecializationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt   DateTime?            @map("reviewed_at") @db.Timestamptz()
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  @@index([coachId, sportId], map: "idx_coach_spec_coach_sport")
  @@index([status, createdAt], map: "idx_coach_spec_status_date")
  @@map("coach_specializations")
}
