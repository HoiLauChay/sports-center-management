generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  COACH
  MEMBER
  RECEPTIONIST

  @@map("role")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BANNED

  @@map("account_status")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET

  @@map("otp_purpose")
}

model Account {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String        @unique @db.VarChar(255)
  phone             String?       @unique @db.VarChar(20)
  passwordHash      String        @map("password_hash") @db.VarChar(255)
  fullName          String        @map("full_name") @db.VarChar(255)
  avatarUrl         String?       @map("avatar_url")
  role              Role          @default(MEMBER)
  status            AccountStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?     @map("email_verified_at") @db.Timestamptz()
  passwordChangedAt DateTime      @default(now()) @map("password_changed_at") @db.Timestamptz()
  dateOfBirth       DateTime?     @map("date_of_birth") @db.Date
  gender            Gender?
  address           String?       @db.VarChar(500)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  memberProfile       MemberProfile?
  coachProfile        CoachProfile?
  receptionistProfile ReceptionistProfile?
  managerProfile      ManagerProfile?
  refreshTokens       RefreshToken[]

  @@index([role, status], map: "idx_accounts_role_status")
  @@map("accounts")
}

model MemberProfile {
  accountId        String   @id @map("account_id") @db.Uuid
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  emergencyContact String?  @map("emergency_contact") @db.VarChar(255)
  fitnessGoals     String?  @map("fitness_goals")
  healthNotes      String?  @map("health_notes")
  walletBalance    Decimal  @default(0) @map("wallet_balance") @db.Decimal(12, 0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("member_profile")
}

model CoachProfile {
  accountId      String   @id @map("account_id") @db.Uuid
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  bio            String?
  experience     String?
  certifications String?
  coverImageUrl  String?  @map("cover_image_url")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("coach_profile")
}

model ReceptionistProfile {
  accountId  String   @id @map("account_id") @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  staffNotes String?  @map("staff_notes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("receptionist_profile")
}

model ManagerProfile {
  accountId  String   @id @map("account_id") @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  staffNotes String?  @map("staff_notes")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("manager_profile")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([accountId], map: "idx_refresh_tokens_account")
  @@index([expiresAt], map: "idx_refresh_tokens_expires")
  @@map("refresh_tokens")
}

model OtpCode {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String     @db.VarChar(255)
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.VarChar(64)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz()
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz()
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  @@index([email, purpose], map: "idx_otp_email_purpose")
  @@map("otp_codes")
}
